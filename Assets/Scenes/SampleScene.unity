  _qrModeDisObjects:
  - {fileID: 2056131614}
  _qrInfoText: "\u041D\u0430\u0431\u043B\u044E\u0434\u0430\u0439\u0442\u0435 \u0437\u0430
    \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u0430\u043C\u0438 \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u043C
    \u0432\u0440\u0435\u043C\u0435\u043D\u0438, \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0439\u0442\u0435
    \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u0441\u0438\u043C\u0443\u043B\u044F\u0446\u0438\u0438
    \u0438 \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0439\u0442\u0435
    \u0441 3D-\u043C\u043E\u0434\u0435\u043B\u044F\u043C\u0438. \u0418\u0437\u0443\u0447\u0430\u0439\u0442\u0435
